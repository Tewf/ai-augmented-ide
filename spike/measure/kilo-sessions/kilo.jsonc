{
  "$schema": "https://app.kilo.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "enabled_providers": ["local-server"],
  "provider": {
    "local-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "local model server (32k context)",
      "options": { "baseURL": "http://127.0.0.1:11435/v1", "apiKey": "local" },
      "models": {
        "qwen2.5:7b-instruct": { "name": "qwen2.5:7b-instruct", "tool_call": true, "limit": { "context": 32768, "output": 2048 } },
        "qwen3:8b": { "name": "qwen3:8b", "tool_call": true, "reasoning": true, "limit": { "context": 32768, "output": 4096 } }
      }
    }
  },
  "model": "local-server/qwen2.5:7b-instruct"
}
